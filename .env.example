# Salin file ini menjadi .env.local lalu isi nilainya.

# Secret key dari Dashboard Xendit → Settings → API Keys (pakai key development dulu).
# TANPA prefix NEXT_PUBLIC_ → hanya hidup di server, tidak bocor ke browser.
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxx

# Base URL situs, dipakai untuk success/failure redirect Xendit.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL backend API (Go/Echo).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
